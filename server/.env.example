# 复制为 .env，填入真实值后由启动脚本导入。不要把 .env 提交到 Git。
# Bash:  set -a; . ./.env; set +a
# PowerShell: Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }

# 必填：JWT 签名密钥，至少 32 字节。生成：openssl rand -base64 48
TF_JWT_SECRET=

# 必填：API Key 入库加密主密钥，32 字节 Base64。生成：openssl rand -base64 32
TF_MASTER_KEY=

# 生产数据库（MySQL 8）
DB_URL=jdbc:mysql://127.0.0.1:3306/thinkfirst?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=thinkfirst
DB_PASSWORD=

# 可选：数据库连接池
DB_POOL_SIZE=10
DB_MIN_IDLE=2
JPA_DDL_AUTO=update

# 前端地址，多个用英文逗号分隔（不要带结尾斜杠）
TF_CORS_ORIGINS=https://your-domain.example.com

# course07 语料目录；默认 ../app/rag/course07
COACH_DATA_DIR=../app/rag/course07

# DeepSeek
LLM_ENABLED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_QUESTION_MAX_TOKENS=700
LLM_PRD_MAX_TOKENS=3000

# 保存用户 Key 时是否调用 DeepSeek 做一次校验
TF_KEY_VALIDATION=true

# JWT 有效期（小时）
TF_JWT_EXPIRATION_HOURS=168
